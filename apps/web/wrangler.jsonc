{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webgamearena",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/play/brick-playground-3d", "/play/brick-playground-3d.html"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
